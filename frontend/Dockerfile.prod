FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

# Sentry env vars baked at build time
ARG VITE_SENTRY_DSN=""
ARG VITE_SENTRY_ENVIRONMENT="production"
ARG VITE_SENTRY_TRACES_RATE="0.1"
ARG VITE_APP_VERSION="unknown"
ARG VITE_API_URL=""

ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_SENTRY_ENVIRONMENT=$VITE_SENTRY_ENVIRONMENT
ENV VITE_SENTRY_TRACES_RATE=$VITE_SENTRY_TRACES_RATE
ENV VITE_APP_VERSION=$VITE_APP_VERSION
ENV VITE_API_URL=$VITE_API_URL

ARG VITE_SENTRY_REPLAY_ENABLED="false"
ARG VITE_SENTRY_REPLAY_SESSION_RATE="0.1"
ARG VITE_SENTRY_REPLAY_ERROR_RATE="1.0"
ENV VITE_SENTRY_REPLAY_ENABLED=$VITE_SENTRY_REPLAY_ENABLED
ENV VITE_SENTRY_REPLAY_SESSION_RATE=$VITE_SENTRY_REPLAY_SESSION_RATE
ENV VITE_SENTRY_REPLAY_ERROR_RATE=$VITE_SENTRY_REPLAY_ERROR_RATE
RUN npm run build && node scripts/build-nginx-config.mjs

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY --from=builder /tmp/grc-nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
