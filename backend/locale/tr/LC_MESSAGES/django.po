msgstr "Plan kalemi başka bir kursa ait."

#: apps/training/services.py:964
msgid "La voce del piano è di un altro sito."
msgstr "Plan kalemi başka bir tesise ait."

#: apps/training/services.py:1022
msgid "Erogazione registrata."
msgstr "Eğitim oturumu kaydedildi."

#
#: apps/training/services.py:1033
msgid "Indica il sito dell'erogazione."
msgstr "Eğitimin yapıldığı tesisi belirtin."

#
#: apps/training/services.py:1036
msgid "Il corso è archiviato."
msgstr "Kurs arşivlenmiş."

#: apps/training/services.py:1040
