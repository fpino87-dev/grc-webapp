"Kurs bir eğitim planında yer alıyor veya kayıtlı oturumları var: arşivleyin."

#: apps/training/services.py:226
msgid "Il sito di un gruppo non si può cambiare."
msgstr "Bir grubun tesisi değiştirilemez."

#: apps/training/services.py:257
msgid "Il sito di un piano non si può cambiare."
msgstr "Bir planın tesisi değiştirilemez."

#: apps/training/services.py:267
