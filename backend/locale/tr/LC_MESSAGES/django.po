msgstr "Geçersiz yanıt biçimi."

#: apps/controls
#, python-format
msgid "Una risposta supera %(max)s caratteri."
msgstr "Bir yanıt %(max)s karakteri aşıyor."

#: apps/controls
msgid "Servizio IA temporaneamente non disponibile. Riprova più tardi."
msgstr "Yapay zeka hizmeti geçici olarak kullanılamıyor. Lütfen daha sonra tekrar deneyin."

#: apps/controls
msgid "L'intervista VDA ISA è disponibile solo per i controlli TISAX."
msgstr "VDA ISA görüşmesi yalnızca TISAX kontrolleri için kullanılabilir."

#: apps/controls/services/vda_interview.py
#, python-format
msgid "Hai già usato i %(max)s giri di verifica."
msgstr "%(max)s doğrulama turunu zaten kullandınız."

#: apps/controls/services/vda_interview.py
msgid "Rispondi ad almeno una domanda prima della verifica."
msgstr "Doğrulamadan önce en az bir soruyu yanıtlayın."

#: apps/controls/services/vda_interview.py
msgid "Rispondi ad almeno una domanda prima di generare la bozza."
msgstr "Taslağı oluşturmadan önce en az bir soruyu yanıtlayın."

#: apps/suppliers/services.py
#, python-format
msgid "Esiste già un fornitore con questa P.IVA: %(name)s."
msgstr "Bu vergi numarasına sahip bir tedarikçi zaten mevcut: %(name)s."

#: apps/suppliers/services.py
msgid "Esiste già un fornitore con questa P.IVA, registrato su un sito fuori dal tuo perimetro: chiedi a un Compliance Officer di associarlo al tuo sito."
msgstr "Bu vergi numarasına sahip bir tedarikçi, yetki alanınız dışındaki bir tesiste zaten kayıtlı: tesisinizle ilişkilendirmesi için bir Compliance Officer'a başvurun."

#: apps/suppliers/views.py
msgid "Esiste già un fornitore con questa P.IVA."
msgstr "Bu vergi numarasına sahip bir tedarikçi zaten mevcut."

#: apps/suppliers/views.py
msgid "Identificativo fornitore non valido."
msgstr "Geçersiz tedarikçi tanımlayıcısı."

#: apps/pdca/services.py
#, python-format
msgid "Evidenza di implementazione del ciclo PDCA «%(title)s»."
msgstr "«%(title)s» PDCA döngüsünün uygulama kanıtı."

#: apps/pdca/views.py
msgid "Carica un file oppure scegli un'evidenza esistente, non entrambi."
msgstr "Bir dosya yükleyin veya mevcut bir kanıt seçin, ikisini birden değil."

#: apps/pdca/views.py
msgid "Il file dell'evidenza si carica solo nel passaggio da DO a CHECK."
msgstr "Kanıt dosyası yalnızca DO'dan CHECK'e geçişte yüklenebilir."

#: apps/audit_prep/services.py
#, python-format
msgid "Rapporto audit — %(title)s"
msgstr "Denetim raporu — %(title)s"

#: apps/audit_prep/services.py
#, python-format
msgid "Rapporto ufficiale dell'audit «%(title)s»."
msgstr "«%(title)s» denetiminin resmi raporu."

#: apps/audit_prep/views.py
msgid "Il file del rapporto è obbligatorio."
msgstr "Rapor dosyası zorunludur."

#: apps/management_review/report/builder.py
msgid "Seconda parte"
msgstr "İkinci taraf"

#: apps/management_review/report/builder.py
msgid "Terza parte"
msgstr "Üçüncü taraf"

#: apps/audit_prep/services.py
msgid "Un audit multi-sito richiede almeno due siti."
msgstr "Çok tesisli bir denetim en az iki tesis gerektirir."

#: apps/audit_prep/services.py
#, python-format
msgid "Il framework non è assegnato ai siti: %(sites)s."
msgstr "Çerçeve şu tesislere atanmamış: %(sites)s."

#: apps/audit_prep/views.py
msgid "Per modificare un audit multi-sito serve l'accesso a tutti i suoi siti."
msgstr "Çok tesisli bir denetimi değiştirmek için tüm tesislerine erişim gerekir."

#: apps/audit_prep/views.py
msgid "Nessun rapporto allegato a questo audit."
msgstr "Bu denetime ekli rapor yok."

#: apps/audit_prep/views.py
msgid "Questo audit fa parte di un audit multi-sito: i dati comuni si modificano dall'audit comune."
msgstr "Bu denetim çok tesisli bir denetimin parçasıdır: ortak veriler ortak denetimden değiştirilir."

#: apps/audit_prep/services.py
msgid "Per chiudere una non conformità è obbligatoria un'evidenza di chiusura."
msgstr "Bir uygunsuzluğu kapatmak için kapanış kanıtı zorunludur."

#: apps/audit_prep/services.py
msgid "Le note di chiusura devono essere almeno 20 caratteri."
msgstr "Kapanış notları en az 20 karakter olmalıdır."

#: apps/audit_prep/services.py
#, python-format
msgid "Il PDCA collegato «%(title)s» è in fase %(phase)s: il finding si chiude quando l'azione correttiva è completata (PDCA in ACT o chiuso)."
msgstr "Bağlı PDCA «%(title)s» %(phase)s aşamasında: bulgu, düzeltici faaliyet tamamlandığında kapatılır (PDCA ACT aşamasında veya kapalı)."

#: apps/audit_prep/services.py
msgid "Il PDCA collegato è in ACT e verrà chiuso insieme al finding: descrivi nelle note di chiusura l'azione standardizzata (minimo 20 caratteri)."
msgstr "Bağlı PDCA ACT aşamasında ve bulguyla birlikte kapatılacak: standartlaştırılan eylemi kapanış notlarında açıklayın (en az 20 karakter)."

#: apps/audit_prep/services.py
msgid "Il finding è già collegato a un PDCA."
msgstr "Bulgu zaten bir PDCA'ya bağlı."

#: apps/audit_prep/services.py
msgid "Il finding è chiuso: non si collega a un PDCA."
msgstr "Bulgu kapalı: bir PDCA'ya bağlanamaz."

#: apps/audit_prep/services.py
msgid "Il PDCA è chiuso o archiviato."
msgstr "PDCA kapalı veya arşivlenmiş."

#: apps/audit_prep/services.py
msgid "Il PDCA deve essere dello stesso sito dell'audit."
msgstr "PDCA, denetimle aynı tesise ait olmalıdır."

#: apps/audit_prep/services.py
#, python-format
msgid "Il PDCA copre già finding di un altro audit («%(audit)s»): si possono collegare solo finding dello stesso audit."
msgstr "PDCA zaten başka bir denetimin («%(audit)s») bulgularını kapsıyor: yalnızca aynı denetimin bulguları bağlanabilir."

#: apps/audit_prep/services.py
msgid "Il finding non è collegato a un PDCA."
msgstr "Bulgu bir PDCA'ya bağlı değil."

#: apps/audit_prep/services.py
msgid "Il finding è chiuso: il collegamento non si modifica più."
msgstr "Bulgu kapalı: bağlantı artık değiştirilemez."

#: apps/audit_prep/services.py
msgid "Motivo obbligatorio (minimo 10 caratteri)."
msgstr "Neden zorunludur (en az 10 karakter)."

#: apps/audit_prep/views.py
msgid "PDCA non trovato."
msgstr "PDCA bulunamadı."

#: apps/pdca/views.py
msgid "Finding non trovato."
msgstr "Bulgu bulunamadı."

#: apps/pdca/views.py
msgid "Il finding non è collegato a questo PDCA."
msgstr "Bulgu bu PDCA'ya bağlı değil."

#: apps/audit_prep/views.py
msgid "Audit di seconda parte: i punti di verifica sono quelli del cliente, la checklist dei controlli non si usa. Registra i rilievi dell'auditor come finding."
msgstr "İkinci taraf denetimi: doğrulama noktaları müşteriye aittir, kontrol listesi kullanılmaz. Denetçinin tespitlerini bulgu olarak kaydedin."

#: apps/audit_prep/services.py
msgid "Il PDCA è chiuso o archiviato: un finding ancora aperto si collega solo a un PDCA aperto."
msgstr "PDCA kapalı veya arşivlenmiş: hâlâ açık bir bulgu yalnızca açık bir PDCA'ya bağlanabilir."

#: apps/audit_prep/services.py
msgid "Il finding è chiuso: non si apre un nuovo PDCA, collegalo a un PDCA esistente."
msgstr "Bulgu kapalı: yeni PDCA açılmaz, mevcut bir PDCA'ya bağlayın."
