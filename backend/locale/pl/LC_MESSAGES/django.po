#, python-format
msgid "Estensione file non consentita. Formati ammessi: %(formats)s."
msgstr "Niedozwolone rozszerzenie pliku. Dozwolone formaty: %(formats)s."

#: core/uploads.py:154
msgid ""
"Tipo di file non consentito. Il contenuto del file non corrisponde "
"all'estensione."
msgstr "Niedozwolony typ pliku. Zawartość pliku nie odpowiada rozszerzeniu."

#: core/uploads.py:163
#, python-format
msgid "Il contenuto del file non corrisponde all'estensione .%(ext)s."
msgstr "Zawartość pliku nie odpowiada rozszerzeniu .%(ext)s."

