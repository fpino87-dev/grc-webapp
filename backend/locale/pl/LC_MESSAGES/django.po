msgstr "Nieprawidłowy identyfikator dostawcy."

#: apps/pdca/services.py
#, python-format
msgid "Evidenza di implementazione del ciclo PDCA «%(title)s»."
msgstr "Dowód wdrożenia cyklu PDCA «%(title)s»."

#: apps/pdca/views.py
msgid "Carica un file oppure scegli un'evidenza esistente, non entrambi."
msgstr "Wgraj plik albo wybierz istniejący dowód, nie oba naraz."

#: apps/pdca/views.py
msgid "Il file dell'evidenza si carica solo nel passaggio da DO a CHECK."
msgstr "Plik dowodu można wgrać tylko przy przejściu z DO do CHECK."

#: apps/audit_prep/services.py
#, python-format
msgid "Rapporto audit — %(title)s"
msgstr "Raport z audytu — %(title)s"

#: apps/audit_prep/services.py
#, python-format
msgid "Rapporto ufficiale dell'audit «%(title)s»."
msgstr "Oficjalny raport z audytu «%(title)s»."

#: apps/audit_prep/views.py
msgid "Il file del rapporto è obbligatorio."
msgstr "Plik raportu jest wymagany."

#: apps/management_review/report/builder.py
msgid "Seconda parte"
msgstr "Druga strona"

#: apps/management_review/report/builder.py
msgid "Terza parte"
msgstr "Trzecia strona"

#: apps/audit_prep/services.py
msgid "Un audit multi-sito richiede almeno due siti."
msgstr "Audyt wielu zakładów wymaga co najmniej dwóch zakładów."

#: apps/audit_prep/services.py
#, python-format
msgid "Il framework non è assegnato ai siti: %(sites)s."
msgstr "Framework nie jest przypisany do zakładów: %(sites)s."

#: apps/audit_prep/views.py
msgid "Per modificare un audit multi-sito serve l'accesso a tutti i suoi siti."
msgstr "Zmiana audytu wielu zakładów wymaga dostępu do wszystkich jego zakładów."

#: apps/audit_prep/views.py
msgid "Nessun rapporto allegato a questo audit."
msgstr "Do tego audytu nie załączono raportu."

#: apps/audit_prep/views.py
msgid "Questo audit fa parte di un audit multi-sito: i dati comuni si modificano dall'audit comune."
msgstr "Ten audyt jest częścią audytu wielu zakładów: wspólne dane zmienia się w audycie wspólnym."

#: apps/audit_prep/services.py
msgid "Per chiudere una non conformità è obbligatoria un'evidenza di chiusura."
msgstr "Zamknięcie niezgodności wymaga dowodu zamknięcia."

#: apps/audit_prep/services.py
msgid "Le note di chiusura devono essere almeno 20 caratteri."
msgstr "Uwagi zamknięcia muszą mieć co najmniej 20 znaków."

#: apps/audit_prep/services.py
#, python-format
msgid "Il PDCA collegato «%(title)s» è in fase %(phase)s: il finding si chiude quando l'azione correttiva è completata (PDCA in ACT o chiuso)."
msgstr "Powiązany PDCA «%(title)s» jest w fazie %(phase)s: ustalenie zamyka się po zakończeniu działania korygującego (PDCA w ACT lub zamknięty)."

#: apps/audit_prep/services.py
msgid "Il PDCA collegato è in ACT e verrà chiuso insieme al finding: descrivi nelle note di chiusura l'azione standardizzata (minimo 20 caratteri)."
msgstr "Powiązany PDCA jest w fazie ACT i zostanie zamknięty razem z ustaleniem: opisz w uwagach zamknięcia ustandaryzowane działanie (co najmniej 20 znaków)."

#: apps/audit_prep/services.py
msgid "Il finding è già collegato a un PDCA."
msgstr "Ustalenie jest już powiązane z PDCA."

#: apps/audit_prep/services.py
msgid "Il finding è chiuso: non si collega a un PDCA."
msgstr "Ustalenie jest zamknięte: nie można go powiązać z PDCA."

#: apps/audit_prep/services.py
msgid "Il PDCA è chiuso o archiviato."
msgstr "PDCA jest zamknięty lub zarchiwizowany."

#: apps/audit_prep/services.py
msgid "Il PDCA deve essere dello stesso sito dell'audit."
msgstr "PDCA musi należeć do tego samego zakładu co audyt."

#: apps/audit_prep/services.py
#, python-format
msgid "Il PDCA copre già finding di un altro audit («%(audit)s»): si possono collegare solo finding dello stesso audit."
msgstr "PDCA obejmuje już ustalenia innego audytu («%(audit)s»): można powiązać tylko ustalenia tego samego audytu."

#: apps/audit_prep/services.py
msgid "Il finding non è collegato a un PDCA."
msgstr "Ustalenie nie jest powiązane z PDCA."

#: apps/audit_prep/services.py
msgid "Il finding è chiuso: il collegamento non si modifica più."
msgstr "Ustalenie jest zamknięte: powiązania nie można już zmienić."

#: apps/audit_prep/services.py
msgid "Motivo obbligatorio (minimo 10 caratteri)."
msgstr "Powód jest wymagany (co najmniej 10 znaków)."

#: apps/audit_prep/views.py
msgid "PDCA non trovato."
msgstr "Nie znaleziono PDCA."

#: apps/pdca/views.py
msgid "Finding non trovato."
msgstr "Nie znaleziono ustalenia."

#: apps/pdca/views.py
msgid "Il finding non è collegato a questo PDCA."
msgstr "Ustalenie nie jest powiązane z tym PDCA."

#: apps/audit_prep/views.py
msgid "Audit di seconda parte: i punti di verifica sono quelli del cliente, la checklist dei controlli non si usa. Registra i rilievi dell'auditor come finding."
msgstr "Audyt drugiej strony: kryteria weryfikacji są klienta, lista kontrolna nie jest używana. Zarejestruj ustalenia audytora jako ustalenia."

#: apps/audit_prep/services.py
msgid "Il PDCA è chiuso o archiviato: un finding ancora aperto si collega solo a un PDCA aperto."
msgstr "PDCA jest zamknięty lub zarchiwizowany: wciąż otwarte ustalenie można powiązać tylko z otwartym PDCA."

#: apps/audit_prep/services.py
msgid "Il finding è chiuso: non si apre un nuovo PDCA, collegalo a un PDCA esistente."
msgstr "Ustalenie jest zamknięte: nie otwiera się nowego PDCA, powiąż je z istniejącym PDCA."
