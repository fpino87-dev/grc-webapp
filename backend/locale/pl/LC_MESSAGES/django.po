"najmniej 50 znaków."

#: apps/suppliers/services.py:369
msgid "Solo assessment completati possono essere approvati."
msgstr "Tylko zakończone oceny mogą zostać zatwierdzone."

#: apps/suppliers/services.py:401
msgid "Motivazione rifiuto obbligatoria (min 10 caratteri)."
msgstr "Uzasadnienie odrzucenia jest obowiązkowe (minimum 10 znaków)."

#: apps/suppliers/services.py:446
msgid "Nessun indirizzo email configurato per questo fornitore."
msgstr "Brak skonfigurowanego adresu e-mail dla tego dostawcy."

#: apps/suppliers/services.py:502
msgid "Il questionario ha già ricevuto risposta."
msgstr "Kwestionariusz już otrzymał odpowiedź."

#: apps/suppliers/services.py:547
msgid "Esito di rischio non valido."
msgstr "Nieprawidłowy wynik ryzyka."

#: apps/suppliers/services.py:549
msgid "La data di valutazione non può essere nel futuro."
msgstr "Data oceny nie może być w przyszłości."

#: apps/suppliers/services.py:636
msgid ""
"Indica nelle note il riferimento della valutazione (es. questionario, audit, "
"data e autore)."
msgstr ""
"W uwagach podaj odniesienie do oceny (np. kwestionariusz, audyt, data i "
"autor)."

#: apps/tasks/serializers.py:72
msgid "Deve essere una lista di giorni."
msgstr "Musi to być lista dni."

#: apps/tasks/serializers.py:77
msgid "I giorni devono essere interi da 0 (lun) a 6 (dom)."
msgstr "Dni muszą być liczbami całkowitymi od 0 (pon) do 6 (niedz)."

#: apps/tasks/serializers.py:91
msgid "Indicare un giorno da 1 a 28, oppure 0 per l'ultimo giorno del mese."
msgstr "Podaj dzień od 1 do 28 albo 0 dla ostatniego dnia miesiąca."

#: apps/tasks/serializers.py:100
msgid ""
"Il mese di partenza deve essere compreso fra 1 (gennaio) e 12 (dicembre)."
msgstr ""
"Miesiąc początkowy musi mieścić się w zakresie od 1 (styczeń) do 12 "
"(grudzień)."

#: apps/tasks/serializers.py:109
msgid "Per la frequenza settimanale indicare un solo giorno."
msgstr "Dla częstotliwości tygodniowej wskaż tylko jeden dzień."

#: apps/tasks/services.py:453
msgid ""
"Una checklist completata è l'evidenza del controllo eseguito: non è "
"cancellabile."
msgstr ""
"Wypełniona lista kontrolna jest dowodem wykonania zabezpieczenia: nie można "
"jej usunąć."

#: apps/tasks/services.py:490
msgid "Tutti gli item obbligatori devono essere spuntati prima di completare."
msgstr "Wszystkie obowiązkowe pozycje muszą być zaznaczone przed zakończeniem."

#: apps/tasks/views.py:192
msgid "Indicare il sito per cui avviare la checklist."
msgstr "Wskaż zakład, dla którego uruchamiasz listę kontrolną."

#: apps/tasks/views.py:198
msgid "Sito non trovato o non attivo."
msgstr "Nie znaleziono zakładu lub jest nieaktywny."

#: apps/tasks/views.py:335
msgid "Questo KPI si calcola da solo: il valore non va inserito a mano."
msgstr ""
"Ten KPI jest obliczany automatycznie: wartości nie wpisuje się ręcznie."

#: apps/tasks/views.py:344
msgid "Valore numerico obbligatorio."
msgstr "Wymagana jest wartość liczbowa."

#: apps/tasks/views.py:354 apps/training/views.py:207
msgid "Sito non trovato."
msgstr "Nie znaleziono zakładu."

#: apps/tasks/views.py:364
msgid "Settimana non valida (formato atteso AAAA-MM-GG)."
msgstr "Nieprawidłowy tydzień (oczekiwany format RRRR-MM-DD)."

